            {"label": "Eurozona", "geo": "EA", "sources": [{"type": "eurostat", "dataset": "namq_10_gdp", "filters": {"na_item": "B1GQ", "unit": "CLV_PCH_PRE", "s_adj": "SCA"}}]}
          ]
        },
        {
          "id": "pib_ia",
          "title": "PIB, variación interanual",
          "unit": "%",
          "decimals": 1,
          "zero_line": true,
          "note": "Respecto al mismo trimestre del año anterior.",
