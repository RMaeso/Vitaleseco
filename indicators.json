            {"label": "España", "geo": "ES", "sources": [{"type": "eurostat", "dataset": "namq_10_gdp", "filters": {"na_item": "B1GQ", "unit": "CLV_PCH_SM", "s_adj": "SCA"}}]},
            {"label": "Eurozona", "geo": "EA", "sources": [{"type": "eurostat", "dataset": "namq_10_gdp", "filters": {"na_item": "B1GQ", "unit": "CLV_PCH_SM", "s_adj": "SCA"}}]}
