            {"label": "Eurozona", "geo": "EA", "sources": [{"type": "eurostat", "dataset": "sts_inpr_m", "filters": {"indic_bt": "PRD", "nace_r2": "B-D", "s_adj": "CA", "unit": "PCH_SM"}}]}
